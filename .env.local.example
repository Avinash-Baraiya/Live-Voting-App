# Local development settings: Redis and PostgreSQL run in Docker (docker-compose.yml).
# Setup: cp .env.local.example .env.local   then: ./run.sh local
# .env.local is gitignored. These values only work on this machine (ports bound to 127.0.0.1).

# PostgreSQL -> Docker container (profile: postgres)
export SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/voting
export SPRING_DATASOURCE_USERNAME=voting
export SPRING_DATASOURCE_PASSWORD=voting

# Redis -> Docker container (profile: redis)
export SPRING_REDIS_HOST=localhost
export SPRING_REDIS_PORT=6379
export SPRING_REDIS_PASSWORD=
export SPRING_REDIS_DATABASE=0

# App
export SPRING_JPA_HIBERNATE_DDL_AUTO=update
export SPRING_JPA_SHOW_SQL=false
export SERVER_PORT=8080
export HEALTH_SHOW_DETAILS=always
