# Copy to .env (gitignored), fill in real values, then: source .env && ./mvnw spring-boot:run
# Never commit real credentials.

# PostgreSQL (required). For Supabase use the Session pooler connection (IPv4).
export SPRING_DATASOURCE_URL=jdbc:postgresql://<pooler-host>:5432/postgres
export SPRING_DATASOURCE_USERNAME=postgres.<project-ref>
export SPRING_DATASOURCE_PASSWORD=<db-password>

# Redis (defaults to localhost:6379 without a password)
export SPRING_REDIS_HOST=localhost
export SPRING_REDIS_PORT=6379
export SPRING_REDIS_PASSWORD=
# Set to true for managed Redis that requires TLS
export SPRING_REDIS_SSL=false

# Optional
export SPRING_JPA_HIBERNATE_DDL_AUTO=update
export SPRING_JPA_SHOW_SQL=false
export SERVER_PORT=8080
